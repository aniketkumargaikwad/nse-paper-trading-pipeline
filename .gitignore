# --- Secrets: NEVER commit these -------------------------------------------
.env
.streamlit/secrets.toml

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# --- Local artifacts --------------------------------------------------------
backtest_results/
*.csv
!sample_data/*.csv
# Universe snapshots are committed ON PURPOSE, not local artifacts: they are
# the fallback that keeps universes resolving when NSE blocks its endpoints,
# and the record of how old a membership was when a backtest used it.
!data/universes/*.csv

# --- OS / editor noise ------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# Parquet candle files are DATA, not source. They are regenerable from the
# provider and can reach gigabytes; the repo is not the place for them.
data/candles/
