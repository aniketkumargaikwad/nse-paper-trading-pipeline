# ---------------------------------------------------------------------------
# Streamlit secrets for the dashboard.
#
# LOCAL:  copy this file to .streamlit/secrets.toml (which is gitignored).
# CLOUD:  paste the two lines into Streamlit Community Cloud ->
#         your app -> Settings -> Secrets.
#
# Use the ANON (public) key from Supabase: Project Settings -> API.
# NEVER put the service-role key here — the dashboard refuses to start
# with it, and it would grant write access to anyone viewing the app.
# ---------------------------------------------------------------------------

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key-here"
