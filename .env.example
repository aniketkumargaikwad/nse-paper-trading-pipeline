# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for LOCAL runs only.
# In GitHub Actions these are injected from GitHub Secrets instead.
#
# NEVER commit the real `.env` file. It is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Supabase (REQUIRED) -----------------------------------------------------
# Project Settings -> API. SUPABASE_URL looks like:
#   https://abcdefghijkl.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key: full read/write. Used ONLY by the engine/backtester/login
# script — never by the dashboard (the dashboard uses the read-only anon key
# via Streamlit secrets, configured separately).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# --- Market data provider (OPTIONAL — defaults to the free one) --------------
# yfinance = FREE. No account, no API key, NO daily login. This is the
#            default if you leave the line commented out.
#            Limits: ~60 days of 15m/30m history, ~730 days of 60m,
#            years of daily. Unofficial API, so it can break occasionally.
# kite     = Zerodha Kite Connect. Requires the PAID "Connect" plan (the free
#            Personal tier has no historical-data API) AND a daily 2FA login
#            via login.py. Only then fill in the two KITE_ values below.
#DATA_PROVIDER=yfinance


# --- Kite Connect (ONLY needed when DATA_PROVIDER=kite) ----------------------
# Leave these blank/commented on the free provider.
# Get them at https://developers.kite.trade after creating a "Connect" app.
#KITE_API_KEY=your_kite_api_key_here
#KITE_API_SECRET=your_kite_api_secret_here


# --- Simulation tuning (OPTIONAL — safe defaults exist in config.py) ---------
# Simulated slippage applied to every fill, in percent (0.05 = 0.05%).
#SLIPPAGE_PCT=0.05
# Simulated round-trip cost per trade, in rupees.
#COST_PER_TRADE_INR=30
